{
  "name": "wort-deutsch",
  "version": "1.1.0",
  "private": true,
  "description": "Wort 德语词句学习与间隔复习",
  "author": "EVEAUSTIN",
  "main": "desktop/main.cjs",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "electron .",
    "vendor": "node scripts/vendor.cjs",
    "test": "node --test tests/*.test.cjs",
    "test:browser": "node tests/browser.cjs",
    "test:desktop": "node tests/desktop-smoke.cjs",
    "build:win": "npm run vendor && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "marked": "18.1.2",
    "dompurify": "3.4.17",
    "jsdom": "30.1.3",
    "playwright": "1.61.1"
  },
  "build": {
    "appId": "com.eveaustin.wort",
    "productName": "Wort",
    "asar": true,
    "directories": { "output": "dist" },
    "files": ["index.html", "app.js", "learning.js", "grammar.js", "library-context.js", "styles.css", "vendor/**", "desktop/**", "package.json"],
    "publish": [{ "provider": "github", "owner": "EVEAUSTIN", "repo": "Deutschland", "releaseType": "release" }],
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }], "artifactName": "Wort-Setup-${version}.${ext}" },
    "nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true, "deleteAppDataOnUninstall": false, "createDesktopShortcut": true, "shortcutName": "Wort" }
  }
}
